# Copy to .env and fill in. Never commit .env.

# Supabase → Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Connect → "Session pooler" or direct connection string (port 5432). Used for migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Supabase Storage (S3-compatible) for uploaded images.
# Supabase → Storage → Settings → S3 Connection / Access keys. Create a public bucket, e.g. "media".
# Leave blank locally to store uploads in ./media instead.
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
